# ==============================================================================
# Environment Configuration: LOCAL (Developer Workstation)
# ==============================================================================
ENVIRONMENT=local
DEBUG=True
APP_PORT=8000
APP_HOST=0.0.0.0
SECRET_KEY=insecure-local-dev-secret-key-change-in-production
LOG_LEVEL=DEBUG

# Local Backing Infrastructure (Docker Compose: PostgreSQL 16 + Valkey 8)
DATABASE_URL=postgresql://appuser:apppassword@localhost:5432/appdb
VALKEY_URL=redis://localhost:6379/0
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppassword
POSTGRES_PORT=5432
VALKEY_PORT=6379

# Allowed Hosts & CORS
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Stack-Specific Runtime Variables (Uncomment as needed for your chosen stack)
# ------------------------------------------------------------------------------
# .NET / C#:
# ASPNETCORE_ENVIRONMENT=Development
# DOTNET_ENVIRONMENT=Development

# Java / Spring:
# SPRING_PROFILES_ACTIVE=local

# Node.js / TypeScript:
# NODE_ENV=development

# Python:
# PYTHONUNBUFFERED=1

# Rust:
# RUST_LOG=debug
# RUST_BACKTRACE=1

# Go:
# GIN_MODE=debug
