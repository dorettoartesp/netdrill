# ==============================================================================
# Environment Configuration: PRD (Production Environment)
# ==============================================================================
# In production, all secrets MUST be injected via secure Vault / Secret Manager.
ENVIRONMENT=prd
DEBUG=False
APP_PORT=8000
APP_HOST=0.0.0.0
SECRET_KEY=MUST-BE-INJECTED-VIA-ENVIRONMENT-VAULT-NEVER-COMMIT
LOG_LEVEL=WARNING

# Production Infrastructure Connections (Injected via Vault / KMS)
DATABASE_URL=MUST-BE-INJECTED-VIA-ENVIRONMENT-VAULT-NEVER-COMMIT
VALKEY_URL=MUST-BE-INJECTED-VIA-ENVIRONMENT-VAULT-NEVER-COMMIT

# Allowed Hosts & CORS
ALLOWED_HOSTS=api.netdrill.domain.com
CORS_ALLOWED_ORIGINS=https://netdrill.domain.com

# Stack-Specific Runtime Hints
# ASPNETCORE_ENVIRONMENT=Production
# SPRING_PROFILES_ACTIVE=production
# NODE_ENV=production
