# Files excluded from `vercel` CLI uploads (local deploys and scripts/deploy.sh).
# Vercel builds from source, so local state, secrets and tooling caches must never be sent.

# Secrets and local environment files (examples are templates, safe to keep)
.secrets/
.data/
.env
.env.*
!.env.example
!.env.*.example
*.key
*.pem
*.p12
*.pfx
*.cert
*.crt

# Local databases (production uses Turso)
*.db
*.db-journal
*.sqlite3

# Build output and dependencies (rebuilt on Vercel)
node_modules/
.next/
out/
coverage/
*.tsbuildinfo

# Local agent and tooling state (CodeGraph index and daemon socket, caches)
.codegraph/
.superpowers/
.turbo/
