# ==============================================================================
# Environment Configuration: DEV (Development & CI/CD Pipeline)
# ==============================================================================
ENVIRONMENT=dev
DEBUG=False
APP_PORT=8000
APP_HOST=0.0.0.0
SECRET_KEY=change-this-in-dev-pipeline-to-a-secure-random-token-min-50-chars
LOG_LEVEL=INFO

# Dev Infrastructure Connections
DATABASE_URL=postgresql://dev_user:dev_pass@dev-db.internal:5432/app_dev
VALKEY_URL=redis://dev-valkey.internal:6379/0

# Allowed Hosts & CORS
ALLOWED_HOSTS=dev.netdrill.internal,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://dev.netdrill.internal,http://localhost:3000

# Stack-Specific Runtime Hints
# ASPNETCORE_ENVIRONMENT=Development
# SPRING_PROFILES_ACTIVE=dev
# NODE_ENV=development
