# ==============================================================================
# Environment Configuration Template (netdrill)
# ==============================================================================
# This template demonstrates the 12-Factor four-tier environment architecture.
#
# Specific templates:
# - .env.local.example : Local workstation setup (PostgreSQL, Valkey, Debug enabled)
# - .env.dev.example   : Development and CI/CD automated test pipeline
# - .env.hml.example   : Homologation / Staging mirroring production topology
# - .env.prd.example   : Production (secrets injected via secure cloud vault)
#
# To get started locally:
#   cp .env.local.example .env

ENVIRONMENT=local
DEBUG=True
APP_PORT=8000
APP_HOST=0.0.0.0
SECRET_KEY=insecure-default-change-in-production-use-a-strong-secret-key
LOG_LEVEL=DEBUG

# Database & Cache Backing Services
DATABASE_URL=postgresql://appuser:apppassword@localhost:5432/appdb
VALKEY_URL=redis://localhost:6379/0

# Allowed Hosts & CORS
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
