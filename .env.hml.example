# ==============================================================================
# Environment Configuration: HML (Homologation / Staging / Pre-Production)
# ==============================================================================
ENVIRONMENT=hml
DEBUG=False
APP_PORT=8000
APP_HOST=0.0.0.0
SECRET_KEY=change-this-in-hml-to-a-cryptographically-secure-random-key
LOG_LEVEL=INFO

# Staging Infrastructure Connections
DATABASE_URL=postgresql://hml_user:hml_pass@staging-db.internal:5432/app_hml
VALKEY_URL=redis://staging-valkey.internal:6379/0

# Allowed Hosts & CORS
ALLOWED_HOSTS=hml.netdrill.internal,staging.netdrill.internal
CORS_ALLOWED_ORIGINS=https://hml.netdrill.internal,https://staging.netdrill.internal

# Stack-Specific Runtime Hints
# ASPNETCORE_ENVIRONMENT=Staging
# SPRING_PROFILES_ACTIVE=staging
# NODE_ENV=production
